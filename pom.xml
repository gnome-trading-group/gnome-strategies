<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>group.gnometrading</groupId>
        <artifactId>gnome-parent</artifactId>
        <version>1.5.3</version>
    </parent>

    <!--
        Builds and releases runtime/, the strategy runtime the orchestrator and the backtest engine run strategies on
        (released as gnome-strategies and pinned by them). strategies/ is a separate project on purpose: its strategies
        build against the platform release they pin, never this build's runtime, and they are run by commit, not
        released (see strategies/pom.xml and CLAUDE.md).
    -->
    <artifactId>gnome-strategies-parent</artifactId>
    <version>1.9.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>runtime</module>
    </modules>

    <scm>
        <connection>scm:git:git@github.com:gnome-trading-group/gnome-strategies.git</connection>
        <developerConnection>scm:git:git@github.com:gnome-trading-group/gnome-strategies.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub GTG Apache Maven Packages</name>
            <url>https://maven.pkg.github.com/gnome-trading-group/gnome-strategies</url>
        </repository>
    </distributionManagement>

    <repositories>
        <repository>
            <id>github</id>
            <name>Internal Projects</name>
            <url>https://maven.pkg.github.com/gnome-trading-group/*</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <configuration>
                        <!-- The release gives the parent and runtime the one version the bump action chose. -->
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- StrategyFactory matches configured args to constructor parameters by name. -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
